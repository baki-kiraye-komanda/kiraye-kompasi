							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='800' y='196' font-size='30' font-weight='800' fill='#F2F5FF' text-anchor='end' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_cl * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & "" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.55 + ([Value] - 1) * 0.0583, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0583s'") & "/></text>", "", [Value], ASC)
