		dataCategory: ImageUrl

	/// Ana səhifə: 4 plitə — hər səhifənin əsas rəqəmi
	measure 'VZ Plitələr' =
			VAR _d = FILTER(ADDCOLUMNS(VALUES(Rayon[Rayon]), "@m", [Median kirayə], "@n", [Elan sayı], "@q", [Median 1 m²]), [@n] >= 30)
			VAR _top = TOPN(1, _d, [@m], DESC, [@q], DESC)
			VAR _topN = MAXX(_top, Rayon[Rayon])
			VAR _topM = MAXX(_top, [@m])
			VAR _fit = CALCULATE(DIVIDE(COUNTROWS(FILTER(Elanlar, Elanlar[Kirayə (AZN/ay)] <= 700)), COUNTROWS(Elanlar)), Elanlar[Otaq] = "2", Rayon[Ərazi] = "Bakı şəhəri")
			VAR _yr = CALCULATE(MAX('Maaş'[İl]), ALL('Maaş'))
			VAR _sec = FILTER(ADDCOLUMNS(FILTER(ALL('Maaş'[Sahə]), 'Maaş'[Sahə] <> "İqtisadiyyat üzrə - cəmi"), "@s",
			    CALCULATE(MAX('Maaş'[Orta maaş (AZN)]), 'Maaş'[İl] = _yr)), NOT ISBLANK([@s]))
			VAR _need1 = CALCULATE([Median kirayə], Elanlar[Otaq] = "1", Rayon[Ərazi] = "Bakı şəhəri") / 0.3
			VAR _ok = COUNTROWS(FILTER(_sec, [@s] >= _need1))
			VAR _ns = COUNTROWS(_sec)
			VAR _raw = [Xam elan sayı]
			VAR _an = [Analiz elan sayı]
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='1752' height='318' viewBox='0 0 1752 318'><defs></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<text x='104' y='74' font-size='14' font-weight='800' fill='#22E5FF' text-anchor='start' letter-spacing='1.6'>BAZAR XƏRİTƏSİ</text>"
							& "<text x='104' y='98' font-size='15' font-weight='400' fill='#9AA6D6' text-anchor='start'>Harada nə qədərdir?</text>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.4s' dur='0.4s' fill='freeze'/>" & "<text x='28' y='170' font-size='17' font-weight='400' fill='#9AA6D6' text-anchor='start'>" & "Ən baha: " & _topN & "</text>" & "</g>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.6s' dur='0.4s' fill='freeze'/>" & "<text x='28' y='228' font-size='40' font-weight='800' fill='#22E5FF' text-anchor='start'>" & SUBSTITUTE(FORMAT(_topM, "#,0", "en-US"), ",", " ") & " AZN" & "</text>" & "</g>"
							& "<text x='28' y='286' font-size='16' font-weight='700' fill='#22E5FF'>Bax  →<animate attributeName='opacity' values='1;0.35;1' dur='2.4s' begin='0.0s' repeatCount='indefinite'/></text>"
							& "<text x='548' y='74' font-size='14' font-weight='800' fill='#FFC23F' text-anchor='start' letter-spacing='1.6'>BÜDCƏM NƏYƏ ÇATIR?</text>"
							& "<text x='548' y='98' font-size='15' font-weight='400' fill='#9AA6D6' text-anchor='start'>Məbləğinizə uyğun rayonlar</text>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.55s' dur='0.4s' fill='freeze'/>" & "<text x='472' y='170' font-size='17' font-weight='400' fill='#9AA6D6' text-anchor='start'>" & "700 AZN ilə 2 otaqlı elanların" & "</text>" & "</g>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.75s' dur='0.4s' fill='freeze'/>" & "<text x='472' y='228' font-size='40' font-weight='800' fill='#FFC23F' text-anchor='start'>" & FORMAT(_fit, "0%") & "-i" & "</text>" & "</g>"
							& "<text x='472' y='286' font-size='16' font-weight='700' fill='#FFC23F'>Bax  →<animate attributeName='opacity' values='1;0.35;1' dur='2.4s' begin='0.4s' repeatCount='indefinite'/></text>"
							& "<text x='992' y='74' font-size='14' font-weight='800' fill='#FF5A7A' text-anchor='start' letter-spacing='1.6'>MAAŞ VƏ KİRAYƏ YÜKÜ</text>"
							& "<text x='992' y='98' font-size='15' font-weight='400' fill='#9AA6D6' text-anchor='start'>Kimin maaşı kirayəyə çatır?</text>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.7s' dur='0.4s' fill='freeze'/>" & "<text x='916' y='170' font-size='17' font-weight='400' fill='#9AA6D6' text-anchor='start'>" & "1 otaqlını 30% ilə ödəyən sahə" & "</text>" & "</g>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.8999999999999999s' dur='0.4s' fill='freeze'/>" & "<text x='916' y='228' font-size='40' font-weight='800' fill='#FF5A7A' text-anchor='start'>" & _ok & " / " & _ns & "</text>" & "</g>"
							& "<text x='916' y='286' font-size='16' font-weight='700' fill='#FF5A7A'>Bax  →<animate attributeName='opacity' values='1;0.35;1' dur='2.4s' begin='0.8s' repeatCount='indefinite'/></text>"
							& "<text x='1436' y='74' font-size='14' font-weight='800' fill='#8B5CFF' text-anchor='start' letter-spacing='1.6'>METODOLOGİYA</text>"
							& "<text x='1436' y='98' font-size='15' font-weight='400' fill='#9AA6D6' text-anchor='start'>Rəqəmlərə niyə inanmaq olar?</text>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.85s' dur='0.4s' fill='freeze'/>" & "<text x='1360' y='170' font-size='17' font-weight='400' fill='#9AA6D6' text-anchor='start'>" & SUBSTITUTE(FORMAT(_raw, "#,0", "en-US"), ",", " ") & " xam elandan" & "</text>" & "</g>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='1.0499999999999998s' dur='0.4s' fill='freeze'/>" & "<text x='1360' y='228' font-size='40' font-weight='800' fill='#8B5CFF' text-anchor='start'>" & SUBSTITUTE(FORMAT(_an, "#,0", "en-US"), ",", " ") & " unikal" & "</text>" & "</g>"
							& "<text x='1360' y='286' font-size='16' font-weight='700' fill='#8B5CFF'>Bax  →<animate attributeName='opacity' values='1;0.35;1' dur='2.4s' begin='1.2000000000000002s' repeatCount='indefinite'/></text>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: c3c82648-18b3-5829-936a-1d5724f66e54
		dataCategory: ImageUrl

	/// Bazar KPI: elan sayı (filtrə görə)
	measure 'VZ MK Elan' =
			VAR _n = [Elan sayı]
			VAR _all = CALCULATE([Elan sayı], REMOVEFILTERS())
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='331' height='136' viewBox='0 0 331 136'><defs><filter id='kg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='3' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<rect x='22' y='0' width='100' height='3' rx='1.5' fill='#22E5FF' filter='url(#kg)'/>"
							& "<text x='22' y='34' class='l'>ELAN SAYI</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='22' y='86' font-size='42' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_n * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & "" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='22' y='116' font-size='14' font-weight='600' fill='#22E5FF' text-anchor='start'>" & FORMAT(DIVIDE(_n, _all), "0%") & " bütün elanlardan" & "</text>" & "</g>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: f43dc1b1-4ebb-5a12-8d60-4e3c6237d4f5
		dataCategory: ImageUrl

	/// Bazar KPI: median kirayə
	measure 'VZ MK Median' =
			VAR _m = [Median kirayə]
			VAR _p25 = [P25 kirayə]
			VAR _p75 = [P75 kirayə]
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='331' height='136' viewBox='0 0 331 136'><defs><filter id='kg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='3' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<rect x='22' y='0' width='100' height='3' rx='1.5' fill='#8B5CFF' filter='url(#kg)'/>"
							& "<text x='22' y='34' class='l'>MEDİAN KİRAYƏ, AZN</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='22' y='86' font-size='42' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_m * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & "" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='22' y='116' font-size='14' font-weight='600' fill='#8B5CFF' text-anchor='start'>" & "orta 50%: " & SUBSTITUTE(FORMAT(_p25, "#,0", "en-US"), ",", " ") & "–" & SUBSTITUTE(FORMAT(_p75, "#,0", "en-US"), ",", " ") & "</text>" & "</g>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: 880093ab-dddf-5d19-ab76-c8027d9e4bac
		dataCategory: ImageUrl

	/// Bazar KPI: 1 m² medianı
	measure 'VZ MK M2' =
			VAR _v = [Median 1 m²]
			VAR _a = [Median sahə]
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='331' height='136' viewBox='0 0 331 136'><defs><filter id='kg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='3' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<rect x='22' y='0' width='100' height='3' rx='1.5' fill='#FF3FD1' filter='url(#kg)'/>"
							& "<text x='22' y='34' class='l'>MEDİAN 1 M², AZN / AY</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='22' y='86' font-size='42' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_v * (1 - POWER(1 - [Value] / 12, 3)), "0.0", "en-US"), ",", " ") & "" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='22' y='116' font-size='14' font-weight='600' fill='#FF3FD1' text-anchor='start'>" & "median sahə " & FORMAT(_a, "0") & " m²" & "</text>" & "</g>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: 1a615944-3e91-5315-9ee1-f063e43a949d
		dataCategory: ImageUrl

	/// Bazar KPI: yeni vs köhnə tikili medianı
	measure 'VZ MK Tikili' =
			VAR _nw = CALCULATE([Median kirayə], Elanlar[Tikili növü] = "Yeni tikili")
			VAR _od = CALCULATE([Median kirayə], Elanlar[Tikili növü] = "Köhnə tikili")
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='331' height='136' viewBox='0 0 331 136'><defs><filter id='kg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='3' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<rect x='22' y='0' width='100' height='3' rx='1.5' fill='#FFC23F' filter='url(#kg)'/>"
							& "<text x='22' y='34' class='l'>YENİ / KÖHNƏ TİKİLİ</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='22' y='86' font-size='42' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_nw * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & "" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='22' y='116' font-size='14' font-weight='600' fill='#FFC23F' text-anchor='start'>" & IF(ISBLANK(_od), "", "köhnə tikili " & SUBSTITUTE(FORMAT(_od, "#,0", "en-US"), ",", " ") & " AZN (−" & FORMAT(1 - DIVIDE(_od, _nw), "0%") & ")") & "</text>" & "</g>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: cd51df0a-32ac-5977-a796-0d923a2b6d98
		dataCategory: ImageUrl

	/// Bazar KPI: vasitəçi payı və qiymət fərqi
	measure 'VZ MK Vasitəçi' =
			VAR _p = [Vasitəçi payı]
			VAR _ag = CALCULATE([Median kirayə], Elanlar[Elanı verən] = "Vasitəçi")
			VAR _ow = CALCULATE([Median kirayə], Elanlar[Elanı verən] = "Mülkiyyətçi")
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='331' height='136' viewBox='0 0 331 136'><defs><filter id='kg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='3' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<rect x='22' y='0' width='100' height='3' rx='1.5' fill='#2DF5C4' filter='url(#kg)'/>"
							& "<text x='22' y='34' class='l'>VASİTƏÇİ PAYI</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='22' y='86' font-size='42' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_p * 100 * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & "%" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='22' y='116' font-size='14' font-weight='600' fill='#2DF5C4' text-anchor='start'>" & IF(ISBLANK(_ow), "", "vasitəçi +" & FORMAT(DIVIDE(_ag, _ow) - 1, "0%") & " baha") & "</text>" & "</g>"
							& "<circle cx='284' cy='72' r='30' fill='none' stroke='#FFFFFF' stroke-opacity='0.08' stroke-width='9'/><circle cx='284' cy='72' r='30' fill='none' stroke='#2DF5C4' stroke-width='9' stroke-linecap='round' stroke-dasharray='188.5' stroke-dashoffset='188.5' transform='rotate(-90 284 72)' filter='url(#kg)'><animate attributeName='stroke-dashoffset' to='"
							& FORMAT(188.5 * (1 - _p), "0.0", "en-US")
							& "' dur='1.2s' begin='0.2s' fill='freeze'/></circle>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: bbcb65ab-7f61-50cc-9a78-0de31a1acba9
		dataCategory: ImageUrl

	/// Bazar: rayonlar üzrə P25–P75 aralığı və median (ən az 30 elan)
	measure 'VZ Rayon aralığı' =
			VAR _city = [Median kirayə]
			VAR _d = FILTER(ADDCOLUMNS(VALUES(Rayon[Rayon]), "@n", [Elan sayı], "@m", [Median kirayə], "@p25", [P25 kirayə], "@p75", [P75 kirayə], "@q", [Median 1 m²]), [@n] >= 30)
			VAR _k = COUNTROWS(_d)
			VAR _rh = DIVIDE(340, MAX(_k, 1))
			VAR _r = ADDCOLUMNS(_d, "@i", RANKX(_d, [@m] + [@q] / 1000, , DESC))
			VAR _sx = 1
			VAR _rows = CONCATENATEX(_r,
			    VAR _y = 20 + ([@i] - 1) * _rh + _rh / 2
			    VAR _a = 140 + MIN([@p25], 2400) / 2400 * 630
			    VAR _b = 140 + MIN([@p75], 2400) / 2400 * 630
			    VAR _c = 140 + MIN([@m], 2400) / 2400 * 630
			    VAR _col = SWITCH(TRUE(), [@m] >= 1100, "#FF5A7A", [@m] >= 900, "#FFC23F", [@m] >= 600, "#3D8BFF", "#2DF5C4")
			    VAR _bg = FORMAT(0.1 + ([@i] - 1) * 0.06, "0.00", "en-US")
			    RETURN "<text x='126' y='" & FORMAT(_y + 5, "0.0", "en-US") & "' font-size='14' font-weight='600' fill='#F2F5FF' text-anchor='end'>" & Rayon[Rayon] & "</text>"
			        & "<rect x='" & FORMAT(_a, "0.0", "en-US") & "' y='" & FORMAT(_y - 6, "0.0", "en-US") & "' width='0' height='12' rx='6' fill='url(#rb)'><animate attributeName='width' to='" & FORMAT(MAX(_b - _a, 4), "0.0", "en-US") & "' dur='0.8s' begin='" & _bg & "s' fill='freeze'/></rect>"
			        & "<g opacity='0'><animate attributeName='opacity' to='1' dur='0.3s' begin='" & FORMAT(0.7 + ([@i] - 1) * 0.06, "0.00", "en-US") & "s' fill='freeze'/>"
			        & "<circle cx='" & FORMAT(_c, "0.0", "en-US") & "' cy='" & FORMAT(_y, "0.0", "en-US") & "' r='7' fill='" & _col & "' stroke='#04061A' stroke-width='2' filter='url(#dg)'/>"
			        & "<text x='" & FORMAT(_b + 12, "0.0", "en-US") & "' y='" & FORMAT(_y + 5, "0.0", "en-US") & "' font-size='13' font-weight='700' fill='" & _col & "'>" & SUBSTITUTE(FORMAT([@m], "#,0", "en-US"), ",", " ") & "</text></g>",
			    "", [@i], ASC)
			VAR _cx = 140 + MIN(_city, 2400) / 2400 * 630
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='836' height='412' viewBox='0 0 836 412'><defs><linearGradient id='rb' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#8B5CFF' stop-opacity='0.5'/><stop offset='1' stop-color='#FF3FD1' stop-opacity='0.9'/></linearGradient><filter id='dg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='4' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<line x1='140.0' y1='10' x2='140.0' y2='370' stroke='#FFFFFF' stroke-opacity='0.06'/><text x='140.0' y='392' font-size='12' class='d' text-anchor='middle'>0</text><line x1='245.0' y1='10' x2='245.0' y2='370' stroke='#FFFFFF' stroke-opacity='0.06'/><text x='245.0' y='392' font-size='12' class='d' text-anchor='middle'>400</text><line x1='350.0' y1='10' x2='350.0' y2='370' stroke='#FFFFFF' stroke-opacity='0.06'/><text x='350.0' y='392' font-size='12' class='d' text-anchor='middle'>800</text><line x1='455.0' y1='10' x2='455.0' y2='370' stroke='#FFFFFF' stroke-opacity='0.06'/><text x='455.0' y='392' font-size='12' class='d' text-anchor='middle'>1 200</text><line x1='560.0' y1='10' x2='560.0' y2='370' stroke='#FFFFFF' stroke-opacity='0.06'/><text x='560.0' y='392' font-size='12' class='d' text-anchor='middle'>1 600</text><line x1='665.0' y1='10' x2='665.0' y2='370' stroke='#FFFFFF' stroke-opacity='0.06'/><text x='665.0' y='392' font-size='12' class='d' text-anchor='middle'>2 000</text><line x1='770.0' y1='10' x2='770.0' y2='370' stroke='#FFFFFF' stroke-opacity='0.06'/><text x='770.0' y='392' font-size='12' class='d' text-anchor='middle'>2 400</text>"
							& _rows
							& "<line y1='6' y2='370' stroke='#22E5FF' stroke-dasharray='4 4' stroke-opacity='0.8' x1='"
							& FORMAT(_cx, "0.0", "en-US")
							& "' x2='"
							& FORMAT(_cx, "0.0", "en-US")
							& "'/>"
							& "<text x='" & FORMAT(_cx + 6, "0", "en-US") & "' y='14' font-size='12' font-weight='600' fill='#22E5FF' text-anchor='start'>" & "seçimin medianı " & SUBSTITUTE(FORMAT(_city, "#,0", "en-US"), ",", " ") & "</text>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: 113dd256-7192-5926-8b70-8196b958dbd6
		dataCategory: ImageUrl

	/// Bazar: qiyməti nə müəyyən edir — otaq, tikili növü, elanı verən
	measure 'VZ Amillər' =
			VAR _r = ADDCOLUMNS(FILTER(VALUES(Elanlar[Otaq]), CALCULATE([Elan sayı]) >= 30), "@m", [Median kirayə], "@a", [Median sahə])
			VAR _rmx = MAXX(_r, [@m])
			VAR _ladder = CONCATENATEX(_r,
			    VAR _i = SWITCH(Elanlar[Otaq], "1", 0, "2", 1, "3", 2, "4", 3, 4)
			    VAR _x = 40 + _i * 96
			    VAR _hh = 74 * DIVIDE([@m], _rmx)
			    RETURN "<rect x='" & _x & "' y='110' width='56' height='0' rx='6' fill='url(#lg)'><animate attributeName='height' to='" & FORMAT(_hh, "0.0", "en-US") & "' dur='0.8s' begin='" & FORMAT(0.1 + _i * 0.12, "0.00", "en-US") & "s' fill='freeze'/><animate attributeName='y' to='" & FORMAT(110 - _hh, "0.0", "en-US") & "' dur='0.8s' begin='" & FORMAT(0.1 + _i * 0.12, "0.00", "en-US") & "s' fill='freeze'/></rect>"
			        & "<g opacity='0'><animate attributeName='opacity' to='1' dur='0.3s' begin='" & FORMAT(0.8 + _i * 0.12, "0.00", "en-US") & "s' fill='freeze'/><text x='" & (_x + 28) & "' y='" & FORMAT(104 - _hh, "0.0", "en-US") & "' font-size='13' font-weight='700' fill='#F2F5FF' text-anchor='middle'>" & SUBSTITUTE(FORMAT([@m], "#,0", "en-US"), ",", " ") & "</text></g>"
			        & "<text x='" & (_x + 28) & "' y='128' font-size='12' class='m' text-anchor='middle'>" & Elanlar[Otaq] & " otaq · " & FORMAT([@a], "0") & " m²</text>",
			    "", Elanlar[Otaq], ASC)
			VAR _nw = CALCULATE([Median kirayə], Elanlar[Tikili növü] = "Yeni tikili")
			VAR _od = CALCULATE([Median kirayə], Elanlar[Tikili növü] = "Köhnə tikili")
			VAR _nwm = CALCULATE([Median 1 m²], Elanlar[Tikili növü] = "Yeni tikili")
			VAR _odm = CALCULATE([Median 1 m²], Elanlar[Tikili növü] = "Köhnə tikili")
			VAR _nwa = CALCULATE([Median sahə], Elanlar[Tikili növü] = "Yeni tikili")
			VAR _oda = CALCULATE([Median sahə], Elanlar[Tikili növü] = "Köhnə tikili")
			VAR _ag = CALCULATE([Median kirayə], Elanlar[Elanı verən] = "Vasitəçi")
			VAR _ow = CALCULATE([Median kirayə], Elanlar[Elanı verən] = "Mülkiyyətçi")
			VAR _mx2 = MAX(MAX(_nw, _od), MAX(_ag, _ow))
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='1720' height='134' viewBox='0 0 1720 134'><defs><linearGradient id='lg' x1='0' y1='1' x2='0' y2='0'><stop offset='0' stop-color='#FF3FD1' stop-opacity='0.35'/><stop offset='1' stop-color='#22E5FF' stop-opacity='1'/></linearGradient><filter id='kg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='3' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<text x='40' y='18' class='l'>1. OTAQ SAYI — ƏSAS AMİL</text>"
							& _ladder
							& "<text x='600' y='18' class='l'>2. TİKİLİ NÖVÜ</text>"
							& "<text x='1170' y='18' class='l'>3. ELANI VERƏN</text>"
							& "<text x='600' y='50' font-size='14' font-weight='600' fill='#F2F5FF' text-anchor='start'>Yeni tikili</text>"
							& "<rect x='710' y='39' width='250' height='14' rx='7' fill='#FFFFFF' fill-opacity='0.06'/>"
							& "<rect x='710' y='39' width='0' height='14' rx='7.0' fill='#8B5CFF' ><animate attributeName='width' to='" & FORMAT(250 * DIVIDE(_nw, _mx2), "0.0", "en-US") & "' dur='0.8s' begin='0.3s' fill='freeze'/></rect>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='1080' y='52' font-size='15' font-weight='700' fill='#F2F5FF' text-anchor='end'>" & SUBSTITUTE(FORMAT(_nw, "#,0", "en-US"), ",", " ") & " AZN" & "</text>" & "</g>"
							& "<text x='600' y='84' font-size='14' font-weight='600' fill='#F2F5FF' text-anchor='start'>Köhnə tikili</text>"
							& "<rect x='710' y='73' width='250' height='14' rx='7' fill='#FFFFFF' fill-opacity='0.06'/>"
							& "<rect x='710' y='73' width='0' height='14' rx='7.0' fill='#FFC23F' ><animate attributeName='width' to='" & FORMAT(250 * DIVIDE(_od, _mx2), "0.0", "en-US") & "' dur='0.8s' begin='0.5s' fill='freeze'/></rect>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='1.1s' dur='0.4s' fill='freeze'/>" & "<text x='1080' y='86' font-size='15' font-weight='700' fill='#F2F5FF' text-anchor='end'>" & SUBSTITUTE(FORMAT(_od, "#,0", "en-US"), ",", " ") & " AZN" & "</text>" & "</g>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='1.2s' dur='0.4s' fill='freeze'/>" & "<text x='600' y='122' font-size='13' font-weight='400' fill='#9AA6D6' text-anchor='start'>" & "1 m²: " & FORMAT(_nwm, "0.0") & " vs " & FORMAT(_odm, "0.0") & " AZN · sahə " & FORMAT(_nwa, "0") & " vs " & FORMAT(_oda, "0") & " m² → fərq əsasən ölçüdədir" & "</text>" & "</g>"
							& "<text x='1170' y='50' font-size='14' font-weight='600' fill='#F2F5FF' text-anchor='start'>Vasitəçi</text>"
							& "<rect x='1280' y='39' width='250' height='14' rx='7' fill='#FFFFFF' fill-opacity='0.06'/>"
							& "<rect x='1280' y='39' width='0' height='14' rx='7.0' fill='#FF5A7A' ><animate attributeName='width' to='" & FORMAT(250 * DIVIDE(_ag, _mx2), "0.0", "en-US") & "' dur='0.8s' begin='0.3s' fill='freeze'/></rect>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='1650' y='52' font-size='15' font-weight='700' fill='#F2F5FF' text-anchor='end'>" & SUBSTITUTE(FORMAT(_ag, "#,0", "en-US"), ",", " ") & " AZN" & "</text>" & "</g>"
							& "<text x='1170' y='84' font-size='14' font-weight='600' fill='#F2F5FF' text-anchor='start'>Mülkiyyətçi</text>"
							& "<rect x='1280' y='73' width='250' height='14' rx='7' fill='#FFFFFF' fill-opacity='0.06'/>"
							& "<rect x='1280' y='73' width='0' height='14' rx='7.0' fill='#2DF5C4' ><animate attributeName='width' to='" & FORMAT(250 * DIVIDE(_ow, _mx2), "0.0", "en-US") & "' dur='0.8s' begin='0.5s' fill='freeze'/></rect>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='1.1s' dur='0.4s' fill='freeze'/>" & "<text x='1650' y='86' font-size='15' font-weight='700' fill='#F2F5FF' text-anchor='end'>" & SUBSTITUTE(FORMAT(_ow, "#,0", "en-US"), ",", " ") & " AZN" & "</text>" & "</g>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='1.2s' dur='0.4s' fill='freeze'/>" & "<text x='1170' y='122' font-size='13' font-weight='400' fill='#9AA6D6' text-anchor='start'>" & IF(ISBLANK(_ow), "", "Mülkiyyətçi elanı " & FORMAT(1 - DIVIDE(_ow, _ag), "0%") & " ucuzdur → birbaşa sahibdən axtarın") & "</text>" & "</g>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: 49224dd5-7ded-5728-8be6-970159a9bf50
		dataCategory: ImageUrl

	/// Büdcəm: uyğun elan payı halqası və nəticə
	measure 'VZ Büdcə' =
			VAR _p = [Büdcəyə uyğun pay]
			VAR _n = [Büdcəyə uyğun elan]
			VAR _b = [Seçilmiş büdcə]
			VAR _ppl = [Seçilmiş nəfər]
			VAR _pm = [Adambaşına median]
			VAR _gap = [Büdcə fərqi]
			VAR _best = [Ən əlçatan rayon]
			VAR _sal = [Bakı orta maaşı]
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='1276' height='230' viewBox='0 0 1276 230'><defs><linearGradient id='bg1' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#FFC23F'/><stop offset='1' stop-color='#FF3FD1'/></linearGradient><filter id='gl' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='5' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<circle cx='110' cy='115' r='82' fill='none' stroke='#FFFFFF' stroke-opacity='0.07' stroke-width='22'/><circle cx='110' cy='115' r='82' fill='none' stroke='url(#bg1)' stroke-width='22' stroke-linecap='round' stroke-dasharray='515.2' stroke-dashoffset='515.2' transform='rotate(-90 110 115)' filter='url(#gl)'><animate attributeName='stroke-dashoffset' to='"
							& FORMAT(515.2 * (1 - MIN(_p, 1)), "0.0", "en-US")
							& "' dur='1.4s' begin='0.2s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.2 0.8 0.2 1'/></circle>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='110' y='128' font-size='44' font-weight='800' fill='#F2F5FF' text-anchor='middle' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_p * 100 * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & "%" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.1167, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.1167s'") & "/></text>", "", [Value], ASC)
							& "<text x='110' y='152' font-size='14' font-weight='500' fill='#9AA6D6' text-anchor='middle'>elanlar</text>"
							& "<text x='250' y='62' font-size='22' font-weight='500' fill='#9AA6D6' text-anchor='start'>" & "Ayda " & SUBSTITUTE(FORMAT(_b, "#,0", "en-US"), ",", " ") & " AZN" & IF(_ppl = 2, " · 2 nəfər (mənzil ≤ " & SUBSTITUTE(FORMAT(_b * 2, "#,0", "en-US"), ",", " ") & " AZN)", "") & " ilə" & "</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='250' y='128' font-size='60' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_n * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & " uyğun mənzil" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='250' y='170' font-size='17' font-weight='400' fill='#9AA6D6' text-anchor='start'>" & "Adambaşına median kirayə " & SUBSTITUTE(FORMAT(_pm, "#,0", "en-US"), ",", " ") & " AZN · büdcə fərqi " & IF(_gap >= 0, "+", "−") & SUBSTITUTE(FORMAT(ABS(_gap), "#,0", "en-US"), ",", " ") & " AZN" & "</text>" & "</g>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='1.1s' dur='0.4s' fill='freeze'/>" & "<text x='250' y='202' font-size='15' font-weight='600' fill='#FFC23F' text-anchor='start'>" & "Büdcə Bakıda orta maaşın " & FORMAT(DIVIDE(_b, _sal), "0%") & "-i" & IF(DIVIDE(_b, _sal) > 0.3, " — 30% normasından çox", " — normaya uyğun") & "</text>" & "</g>"
							& "<rect x='980' y='40' width='276' height='150' rx='18' fill='#2DF5C4' fill-opacity='0.08' stroke='#2DF5C4' stroke-opacity='0.5'/>"
							& "<text x='1004' y='76' font-size='13' font-weight='800' fill='#2DF5C4' text-anchor='start' letter-spacing='1.6'>ƏN ƏLÇATAN RAYON</text>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.8s' dur='0.4s' fill='freeze'/>" & "<text x='1004' y='128' font-size='34' font-weight='800' fill='#F2F5FF' text-anchor='start'>" & _best & "</text>" & "</g>"
							& "<text x='1004' y='166' font-size='13' font-weight='400' fill='#9AA6D6' text-anchor='start'>ən az 30 elan olan rayonlar</text>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: 08ebdf4e-a8a9-5acf-bd15-c02171d2ecd6
		dataCategory: ImageUrl

	/// Büdcəm: qənaət yolları — median kirayəni addım-addım necə azaltmaq olar
	measure 'VZ Qənaət' =
			VAR _room = SELECTEDVALUE(Elanlar[Otaq], "2")
			VAR _b = [Seçilmiş büdcə]
			VAR _base = CALCULATE([Median kirayə], REMOVEFILTERS(Elanlar), REMOVEFILTERS(Rayon), Elanlar[Otaq] = _room, Rayon[Ərazi] = "Bakı şəhəri")
			VAR _dist = TOPN(4, FILTER(ADDCOLUMNS(CALCULATETABLE(VALUES(Rayon[Rayon]), Rayon[Ərazi] = "Bakı şəhəri"), "@m",
			        CALCULATE([Median kirayə], REMOVEFILTERS(Elanlar[Tikili növü]), Elanlar[Otaq] = _room), "@n",
			        CALCULATE([Elan sayı], REMOVEFILTERS(Elanlar[Tikili növü]), Elanlar[Otaq] = _room)), [@n] >= 30), [@m], ASC)
			VAR _cheap = TREATAS(SELECTCOLUMNS(_dist, "r", Rayon[Rayon]), Rayon[Rayon])
			VAR _s1 = CALCULATE([Median kirayə], REMOVEFILTERS(Elanlar), REMOVEFILTERS(Rayon), Elanlar[Otaq] = _room, _cheap)
			VAR _s2 = CALCULATE([Median kirayə], REMOVEFILTERS(Elanlar), REMOVEFILTERS(Rayon), Elanlar[Otaq] = _room, _cheap, Elanlar[Tikili növü] = "Köhnə tikili")
			VAR _s3 = CALCULATE([Median kirayə], REMOVEFILTERS(Elanlar), REMOVEFILTERS(Rayon), Elanlar[Otaq] = _room, _cheap, Elanlar[Tikili növü] = "Köhnə tikili", Elanlar[Elanı verən] = "Mülkiyyətçi")
			VAR _s4 = _s3 / 2
			VAR _names = CONCATENATEX(_dist, Rayon[Rayon], ", ", [@m], ASC)
			VAR _mx = _base * 1.25
			VAR _steps = {
			    (1, "Başlanğıc: " & _room & " otaqlı, Bakı", _base, _base, "#FF3FD1"),
			    (2, "Ucuz rayonlara baxın", _base, _s1, "#22E5FF"),
			    (3, "+ köhnə tikili", _s1, _s2, "#8B5CFF"),
			    (4, "+ mülkiyyətçi elanı (vasitəçisiz)", _s2, _s3, "#3D8BFF"),
			    (5, "2 nəfər bölüşsün", _s3, _s4, "#2DF5C4")
			}
			VAR _rows = CONCATENATEX(_steps,
			    VAR _y = 30 + ([Value1] - 1) * 86
			    VAR _from = [Value3]
			    VAR _to = [Value4]
			    VAR _x1 = 20 + 560 * DIVIDE(_to, _mx)
			    VAR _x2 = 20 + 560 * DIVIDE(_from, _mx)
			    VAR _bg = FORMAT(0.2 + ([Value1] - 1) * 0.35, "0.00", "en-US")
			    RETURN "<text x='20' y='" & _y & "' font-size='15' font-weight='600' fill='#F2F5FF'>" & [Value2] & "</text>"
			        & IF([Value1] > 1, "<rect x='" & FORMAT(_x1, "0.0", "en-US") & "' y='" & (_y + 12) & "' width='" & FORMAT(_x2 - _x1, "0.0", "en-US") & "' height='26' rx='6' fill='#FFFFFF' fill-opacity='0.05' stroke='" & [Value5] & "' stroke-opacity='0.35' stroke-dasharray='3 3'/>", "")
			        & "<rect x='20' y='" & (_y + 12) & "' width='0' height='26' rx='6' fill='" & [Value5] & "' fill-opacity='0.85' filter='url(#sg)'><animate attributeName='width' to='" & FORMAT(_x1 - 20, "0.0", "en-US") & "' dur='0.7s' begin='" & _bg & "s' fill='freeze'/></rect>"
			        & "<g opacity='0'><animate attributeName='opacity' to='1' dur='0.3s' begin='" & FORMAT(0.6 + ([Value1] - 1) * 0.35, "0.00", "en-US") & "s' fill='freeze'/>"
			        & "<text x='" & FORMAT(_x1 + 10, "0.0", "en-US") & "' y='" & (_y + 31) & "' font-size='16' font-weight='800' fill='#F2F5FF'>" & SUBSTITUTE(FORMAT(_to, "#,0", "en-US"), ",", " ") & " AZN"
			        & IF([Value1] > 1, "<tspan font-size='13' font-weight='600' fill='" & [Value5] & "'>  −" & SUBSTITUTE(FORMAT(_from - _to, "#,0", "en-US"), ",", " ") & "</tspan>", "") & "</text></g>",
			    "", [Value1], ASC)
			VAR _bx = 20 + 560 * DIVIDE(_b, _mx)
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='612' height='560' viewBox='0 0 612 560'><defs><filter id='sg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='3' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& _rows
							& "<line y1='12' y2='460' stroke='#FFC23F' stroke-width='2' stroke-dasharray='5 4' x1='"
							& FORMAT(_bx, "0.0", "en-US")
							& "' x2='"
							& FORMAT(_bx, "0.0", "en-US")
							& "'/>"
							& "<text x='" & FORMAT(MIN(_bx, 470), "0", "en-US") & "' y='478' font-size='13' font-weight='700' fill='#FFC23F' text-anchor='start'>" & "sizin büdcə: " & SUBSTITUTE(FORMAT(_b, "#,0", "en-US"), ",", " ") & " AZN" & "</text>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='2.0s' dur='0.4s' fill='freeze'/>" & "<text x='20' y='510' font-size='13' font-weight='400' fill='#9AA6D6' text-anchor='start'>" & "Ucuz rayonlar: " & _names & "</text>" & "</g>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='2.2s' dur='0.4s' fill='freeze'/>" & "<text x='20' y='536' font-size='15' font-weight='700' fill='#2DF5C4' text-anchor='start'>" & "Nəticə: " & SUBSTITUTE(FORMAT(_s4, "#,0", "en-US"), ",", " ") & " AZN adambaşına = Bakıda orta maaşın " & FORMAT(DIVIDE(_s4, [Bakı orta maaşı]), "0%") & "-i" & "</text>" & "</g>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: 9a05feeb-0a91-541f-b69f-b515374acdd6
		dataCategory: ImageUrl

	/// Maaş: seçilmiş sahənin (və ya Bakının) orta maaşı
	measure 'VZ SL Maaş' =
			VAR _s = [Orta maaş]
			VAR _sec = IF(ISFILTERED('Maaş'[Sahə]), SELECTEDVALUE('Maaş'[Sahə], "seçilmiş sahələr") & " (ölkə üzrə)", "Bakı şəhəri üzrə orta")
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='568' height='150' viewBox='0 0 568 150'><defs><filter id='kg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='3' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<rect x='24' y='0' width='120' height='3' rx='1.5' fill='#8B5CFF' filter='url(#kg)'/>"
							& "<text x='24' y='36' class='l'>ORTA AYLIQ MAAŞ, AZN</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='24' y='94' font-size='48' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_s * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & "" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='24' y='126' font-size='15' font-weight='600' fill='#8B5CFF' text-anchor='start'>" & _sec & "</text>" & "</g>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: 3ee253b1-2424-50f5-b026-3e78a3b79a67
		dataCategory: ImageUrl

	/// Maaş: kirayə yükü halqası (30% norma işarəsi ilə)
	measure 'VZ SL Yük' =
			VAR _y = [Kirayə yükü]
			VAR _pm = [Adambaşına median]
			VAR _col = SWITCH(TRUE(), ISBLANK(_y), "#5B6699", _y <= 0.3, "#2DF5C4", _y <= 0.5, "#FFC23F", "#FF5A7A")
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='568' height='150' viewBox='0 0 568 150'><defs><filter id='kg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='3' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<rect x='24' y='0' width='120' height='3' rx='1.5' fill='#FF5A7A' filter='url(#kg)'/>"
							& "<text x='24' y='36' class='l'>KİRAYƏ YÜKÜ</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='24' y='94' font-size='48' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_y * 100 * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & "%" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='24' y='126' font-size='15' font-weight='600' fill='#FF5A7A' text-anchor='start'>" & "median kirayə " & SUBSTITUTE(FORMAT(_pm, "#,0", "en-US"), ",", " ") & " AZN ÷ maaş" & "</text>" & "</g>"
							& "<circle cx='480' cy='76' r='46' fill='none' stroke='#FFFFFF' stroke-opacity='0.08' stroke-width='12'/><circle cx='480' cy='76' r='46' fill='none' stroke-width='12' stroke-linecap='round' stroke-dasharray='289.0' stroke-dashoffset='289.0' transform='rotate(-90 480 76)' filter='url(#kg)' stroke='"
							& _col
							& "'><animate attributeName='stroke-dashoffset' to='"
							& FORMAT(289.0 * (1 - MIN(_y, 1)), "0.0", "en-US")
							& "' dur='1.2s' begin='0.2s' fill='freeze'/></circle>"
							& "<line x1='514.2' y1='87.1' x2='533.3' y2='93.3' stroke='#2DF5C4' stroke-width='3'/>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: c6c07e50-e3c0-51e3-9f6f-d3287d27e802
		dataCategory: ImageUrl

	/// Maaş: kirayə 30%-dən çox olmasın deyə lazım olan maaş
	measure 'VZ SL Lazım' =
			VAR _pm = [Adambaşına median]
			VAR _need = _pm / 0.3
			VAR _s = [Orta maaş]
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='568' height='150' viewBox='0 0 568 150'><defs><filter id='kg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='3' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<rect x='24' y='0' width='120' height='3' rx='1.5' fill='#FFC23F' filter='url(#kg)'/>"
							& "<text x='24' y='36' class='l'>30% ÜÇÜN LAZIM OLAN MAAŞ</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='24' y='94' font-size='48' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_need * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & "" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='24' y='126' font-size='15' font-weight='600' fill='#FFC23F' text-anchor='start'>" & IF(_s >= _need, "maaş kifayət edir ✓", "maaşdan " & FORMAT(DIVIDE(_need, _s), "0.0") & " dəfə çox") & "</text>" & "</g>"
							& "</svg>"
