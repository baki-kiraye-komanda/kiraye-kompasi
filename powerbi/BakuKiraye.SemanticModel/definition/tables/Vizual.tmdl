							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='2.0s' dur='0.4s' fill='freeze'/>" & "<text x='468' y='433' font-size='14' font-weight='400' fill='#F2F5FF' text-anchor='start'>" & "Bakıda orta maaşdan " & FORMAT(DIVIDE(_need, _sal), "0.0") & " dəfə çox" & "</text>" & "</g>"
