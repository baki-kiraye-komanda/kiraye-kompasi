	/// Maaş: hansı otaq sayını neçə sahənin orta maaşı 30% normasında ödəyir
	measure 'VZ Əlçatanlıq' =
			VAR _ppl = [Seçilmiş nəfər]
			VAR _yr = CALCULATE(MAX('Maaş'[İl]), ALL('Maaş'))
			VAR _sec = FILTER(ADDCOLUMNS(FILTER(ALL('Maaş'[Sahə]), 'Maaş'[Sahə] <> "İqtisadiyyat üzrə - cəmi"), "@s",
			    CALCULATE(MAX('Maaş'[Orta maaş (AZN)]), REMOVEFILTERS('Maaş'), 'Maaş'[Sahə] = EARLIER('Maaş'[Sahə]), 'Maaş'[İl] = _yr)), NOT ISBLANK([@s]))
			VAR _ns = COUNTROWS(_sec)
			VAR _r = { ("1", 0), ("2", 1), ("3", 2), ("4", 3) }
			VAR _rows = CONCATENATEX(_r,
			    VAR _room = [Value1]
			    VAR _m = CALCULATE([Median kirayə], REMOVEFILTERS(Elanlar), Elanlar[Otaq] = _room, Rayon[Ərazi] = "Bakı şəhəri") / _ppl
			    VAR _need = _m / 0.3
			    VAR _ok = COUNTROWS(FILTER(_sec, [@s] >= _need))
			    VAR _y = 40 + [Value2] * 84
			    VAR _dots = CONCATENATEX(GENERATESERIES(1, _ns, 1),
			        "<circle cx='" & (14 + [Value] * 22) & "' cy='" & (_y + 44) & "' r='7' fill='" & IF([Value] <= _ok, "#2DF5C4", "#FFFFFF") & "' fill-opacity='" & IF([Value] <= _ok, "1", "0.10") & "' opacity='0'><set attributeName='opacity' to='1' begin='" & FORMAT(0.2 + [Value] * 0.03 + [Value2] * 0.25, "0.00", "en-US") & "s' fill='freeze'/></circle>", "", [Value], ASC)
			    RETURN "<text x='20' y='" & _y & "' font-size='16' font-weight='700' fill='#F2F5FF'>" & [Value1] & " otaq</text>"
			        & "<text x='496' y='" & _y & "' font-size='15' font-weight='700' fill='#FFC23F' text-anchor='end'>" & SUBSTITUTE(FORMAT(_need, "#,0", "en-US"), ",", " ") & " AZN lazımdır</text>"
			        & _dots
			        & "<text x='496' y='" & (_y + 49) & "' font-size='14' font-weight='800' fill='" & IF(_ok > 0, "#2DF5C4", "#FF5A7A") & "' text-anchor='end'>" & _ok & " / " & _ns & "</text>",
			    "", [Value2], ASC)
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='516' height='400' viewBox='0 0 516 400'><defs></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<text x='20' y='14' font-size='13' font-weight='400' fill='#9AA6D6' text-anchor='start'>Dairə = 1 sahə · yaşıl: orta maaşı kifayət edir</text>"
							& _rows
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='1.5s' dur='0.4s' fill='freeze'/>" & "<text x='20' y='392' font-size='13' font-weight='400' fill='#5B6699' text-anchor='start'>" & IF(_ppl = 2, "2 nəfər bölüşəndə hesablanıb", "Kirayəni 2 nəfər bölsə? Yuxarıda «2» seçin") & "</text>" & "</g>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: 4c38771b-cbc0-57e9-9b5e-4462923542fb
		dataCategory: ImageUrl

