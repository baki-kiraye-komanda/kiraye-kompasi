							& "<text x='24' y='34' class='l'>RAYON</text>"
							& "<text x='24' y='92' font-size='44' font-weight='800' fill='#22E5FF' text-anchor='start'>" & _r & "</text>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.8s' dur='0.4s' fill='freeze'/>" & "<text x='24' y='124' font-size='15' font-weight='600' fill='#FF3FD1' text-anchor='start'>" & "median kirayə Bakı maaşının " & FORMAT(DIVIDE(_m, _sal), "0%") & "-i" & "</text>" & "</g>"
							& "<text x='480' y='34' class='l'>ELAN SAYI</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='480' y='92' font-size='44' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_n * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & "" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<text x='780' y='34' class='l'>MEDİAN KİRAYƏ</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='780' y='92' font-size='44' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_m * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & " AZN" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.15 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<text x='1080' y='34' class='l'>MEDİAN 1 M²</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='1080' y='92' font-size='44' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_m2 * (1 - POWER(1 - [Value] / 12, 3)), "0.0", "en-US"), ",", " ") & " AZN" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.3 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<text x='1380' y='34' class='l'>ORTA 50% (P25–P75)</text>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.5s' dur='0.4s' fill='freeze'/>" & "<text x='1380' y='92' font-size='34' font-weight='800' fill='#F2F5FF' text-anchor='start'>" & SUBSTITUTE(FORMAT(_p25, "#,0", "en-US"), ",", " ") & " – " & SUBSTITUTE(FORMAT(_p75, "#,0", "en-US"), ",", " ") & " AZN" & "</text>" & "</g>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: 74769c95-b142-5395-b899-5cecd9c5a09e
		dataCategory: ImageUrl

	column _
		isHidden
		lineageTag: 5b0c6a52-7c3e-4a59-9a3d-0d7d2b1c9e02
		isNameInferred
		sourceColumn: [_]

	partition Vizual = calculated
		mode: import
		source = ROW("_", BLANK())

