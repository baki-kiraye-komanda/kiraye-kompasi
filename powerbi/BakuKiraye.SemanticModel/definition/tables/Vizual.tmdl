/// Animasiyalı SVG vizual qatı (dax_svg.py ilə yaradılır, əl ilə dəyişməyin)
table Vizual
	lineageTag: 5b0c6a52-7c3e-4a59-9a3d-0d7d2b1c9e01

	/// Ana səhifə: bəgüşən sətir (əsas faktlar + rayon medianları)
	measure 'VZ Ticker' =
			VAR _sal = [Bakı orta maaşı]
			VAR _m2 = CALCULATE([Median kirayə], Elanlar[Otaq] = "2", Rayon[Ərazi] = "Bakı şəhəri", REMOVEFILTERS(Rayon[Rayon]))
			VAR _mas = CALCULATE([Median kirayə], Elanlar[Otaq] = "2", Rayon[Ərazi] <> "Bakı şəhəri")
			VAR _city = CALCULATE([Median kirayə], Rayon[Ərazi] = "Bakı şəhəri")
			VAR _ag = CALCULATE([Median kirayə], Elanlar[Elanı verən] = "Vasitəçi", Rayon[Ərazi] = "Bakı şəhəri")
			VAR _ow = CALCULATE([Median kirayə], Elanlar[Elanı verən] = "Mülkiyyətçi", Rayon[Ərazi] = "Bakı şəhəri")
			VAR _nw = CALCULATE([Median kirayə], Elanlar[Tikili növü] = "Yeni tikili", Rayon[Ərazi] = "Bakı şəhəri")
			VAR _od = CALCULATE([Median kirayə], Elanlar[Tikili növü] = "Köhnə tikili", Rayon[Ərazi] = "Bakı şəhəri")
			VAR _d = FILTER(ADDCOLUMNS(VALUES(Rayon[Rayon]), "@m", [Median kirayə], "@n", [Elan sayı], "@q", [Median 1 m²]), [@n] >= 30)
			VAR _items = UNION(
			    ROW("o", 1, "k", "2 OTAQLI · BAKI", "v", SUBSTITUTE(FORMAT(_m2, "#,0", "en-US"), ",", " ") & " AZN", "c", "#FF3FD1", "e", "= orta maaşın " & FORMAT(DIVIDE(_m2, _sal), "0%") & "-i"),
			    ROW("o", 2, "k", "NORMAYA SIĞMAQ ÜÇÜN MAAŞ", "v", SUBSTITUTE(FORMAT(_m2 / 0.3, "#,0", "en-US"), ",", " ") & " AZN", "c", "#FFC23F", "e", FORMAT(DIVIDE(_m2 / 0.3, _sal), "0.0") & " × Bakı ortası"),
			    ROW("o", 3, "k", "MASAZIR · 2 OTAQ", "v", SUBSTITUTE(FORMAT(_mas, "#,0", "en-US"), ",", " ") & " AZN", "c", "#2DF5C4", "e", "= maaşın " & FORMAT(DIVIDE(_mas, _sal), "0%") & "-i · normaya yaxın"),
			    ROW("o", 4, "k", "VASİTƏÇİ / MÜLKİYYƏTÇİ", "v", SUBSTITUTE(FORMAT(_ag, "#,0", "en-US"), ",", " ") & " / " & SUBSTITUTE(FORMAT(_ow, "#,0", "en-US"), ",", " ") & " AZN", "c", "#FF5A7A", "e", "vasitəçi +" & FORMAT(DIVIDE(_ag, _ow) - 1, "0%")),
			    ROW("o", 5, "k", "YENİ / KÖHNƏ TİKİLİ", "v", SUBSTITUTE(FORMAT(_nw, "#,0", "en-US"), ",", " ") & " / " & SUBSTITUTE(FORMAT(_od, "#,0", "en-US"), ",", " ") & " AZN", "c", "#8B5CFF", "e", "köhnə tikili −" & FORMAT(1 - DIVIDE(_od, _nw), "0%")),
			    SELECTCOLUMNS(_d, "o", 10 + RANKX(_d, [@m] + [@q] / 1000, , DESC), "k", UPPER(SUBSTITUTE(Rayon[Rayon], "i", "İ")), "v", SUBSTITUTE(FORMAT([@m], "#,0", "en-US"), ",", " ") & " AZN",
			        "c", IF([@m] > _city, "#FF5A7A", "#2DF5C4"),
			        "e", IF([@m] > _city, "▲ +", "▼ −") & FORMAT(ABS(DIVIDE([@m], _city) - 1), "0%") & " şəhər medianından")
			)
			VAR _plain = CONCATENATEX(_items, [k] & "  " & [v] & "  " & [e] & "            ✦            ", "")
			VAR _L = ROUND(LEN(_plain) * 8.3, 0)
			VAR _dur = FORMAT(_L / 75, "0.0", "en-US")
			VAR _body = CONCATENATEX(_items,
			    "<tspan fill='#9AA6D6' font-weight='600' font-size='13' letter-spacing='1.2'>" & [k] & "  </tspan><tspan fill='#F2F5FF' font-weight='700'>" & [v] & "</tspan><tspan fill='" & [c] & "' font-weight='600'>  " & [e] & "</tspan><tspan fill='#8B5CFF'>            ✦            </tspan>",
			    "", [o], ASC)
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='1752' height='46' viewBox='0 0 1752 46'><defs><linearGradient id='fg' x1='0' x2='1'><stop offset='0' stop-color='black'/><stop offset='0.04' stop-color='white'/><stop offset='0.96' stop-color='white'/><stop offset='1' stop-color='black'/></linearGradient><mask id='tm'><rect x='236' y='0' width='1516' height='46' fill='url(#fg)'/></mask><linearGradient id='tb' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#FF3FD1' stop-opacity='0.5'/><stop offset='1' stop-color='#22E5FF' stop-opacity='0.35'/></linearGradient><filter id='tg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='3' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<rect x='1' y='1' width='1750' height='44' rx='23.0' fill='#0D1440' fill-opacity='0.8' stroke='url(#tb)' stroke-width='1.4'/><rect x='8' y='8' width='214' height='30' rx='15.0' fill='#FF3FD1' fill-opacity='0.15' stroke='#FF3FD1' stroke-opacity='0.6'/><circle cx='28' cy='23.0' r='5' fill='#FF3FD1' filter='url(#tg)'><animate attributeName='opacity' values='1;0.2;1' dur='1.4s' repeatCount='indefinite'/></circle><text x='42' y='28.0' font-size='13' font-weight='800' letter-spacing='1.8' fill='#FF3FD1'>CANLI BAZAR</text><g mask='url(#tm)'><g><animateTransform attributeName='transform' type='translate' from='236 0' to='"
							& FORMAT(236 - _L, "0", "en-US")
							& "' dur='"
							& _dur
							& "s' repeatCount='indefinite'/><text x='0' y='29.0' font-size='16' xml:space='preserve' textLength='"
							& _L
							& "' lengthAdjust='spacing'>"
							& _body
							& "</text><text x='"
							& _L
							& "' y='29.0' font-size='16' xml:space='preserve' textLength='"
							& _L
							& "' lengthAdjust='spacing'>"
							& _body
							& "</text></g></g>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: 15674577-17a6-5d93-a570-78c818b8a025
		dataCategory: ImageUrl

	/// Ana səhifə: əsas problem — kirayə yükü halqası və müqayisə
	measure 'VZ Hero' =
			VAR _sal = [Bakı orta maaşı]
			VAR _cty = [Ölkə orta maaşı]
			VAR _m2 = CALCULATE([Median kirayə], Elanlar[Otaq] = "2", Rayon[Ərazi] = "Bakı şəhəri")
			VAR _mas = CALCULATE([Median kirayə], Elanlar[Otaq] = "2", Rayon[Ərazi] <> "Bakı şəhəri")
			VAR _p = DIVIDE(_m2, _sal)
			VAR _pm = DIVIDE(_mas, _sal)
			VAR _pc = DIVIDE(_m2, _cty)
			VAR _need = _m2 / 0.3
			VAR _arc = 942.5 * MIN(_p, 1)
			VAR _a = -PI() / 2 + 2 * PI() * _pm
			VAR _mx = 200 + 150 * COS(_a)
			VAR _my = 200 + 150 * SIN(_a)
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='978' height='448' viewBox='0 0 978 448'><defs><linearGradient id='rg' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#FF3FD1'/><stop offset='0.55' stop-color='#8B5CFF'/><stop offset='1' stop-color='#22E5FF'/></linearGradient><filter id='gl' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='6' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter><filter id='hg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='3' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<circle cx='200' cy='220' r='150' fill='none' stroke='#FFFFFF' stroke-opacity='0.07' stroke-width='30'/><g transform='translate(0,20)'><line x1='200.0' y1='27.5' x2='200.0' y2='11.0' stroke='#9AA6D6' stroke-opacity='0.5' stroke-width='1.2'/><line x1='218.0' y1='28.4' x2='219.0' y2='19.5' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='235.9' y1='31.3' x2='237.7' y2='22.5' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='253.3' y1='35.9' x2='256.1' y2='27.4' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='270.2' y1='42.4' x2='273.8' y2='34.2' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='286.2' y1='50.6' x2='294.5' y2='36.3' stroke='#9AA6D6' stroke-opacity='0.5' stroke-width='1.2'/><line x1='301.4' y1='60.4' x2='306.7' y2='53.2' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='315.4' y1='71.8' x2='321.4' y2='65.1' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='328.2' y1='84.6' x2='334.9' y2='78.6' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='339.6' y1='98.6' x2='346.8' y2='93.3' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='349.4' y1='113.8' x2='363.7' y2='105.5' stroke='#9AA6D6' stroke-opacity='0.5' stroke-width='1.2'/><line x1='357.6' y1='129.8' x2='365.8' y2='126.2' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='364.1' y1='146.7' x2='372.6' y2='143.9' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='368.7' y1='164.1' x2='377.5' y2='162.3' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='371.6' y1='182.0' x2='380.5' y2='181.0' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='372.5' y1='200.0' x2='389.0' y2='200.0' stroke='#9AA6D6' stroke-opacity='0.5' stroke-width='1.2'/><line x1='371.6' y1='218.0' x2='380.5' y2='219.0' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='368.7' y1='235.9' x2='377.5' y2='237.7' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='364.1' y1='253.3' x2='372.6' y2='256.1' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='357.6' y1='270.2' x2='365.8' y2='273.8' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='349.4' y1='286.2' x2='363.7' y2='294.5' stroke='#9AA6D6' stroke-opacity='0.5' stroke-width='1.2'/><line x1='339.6' y1='301.4' x2='346.8' y2='306.7' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='328.2' y1='315.4' x2='334.9' y2='321.4' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='315.4' y1='328.2' x2='321.4' y2='334.9' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='301.4' y1='339.6' x2='306.7' y2='346.8' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='286.2' y1='349.4' x2='294.5' y2='363.7' stroke='#9AA6D6' stroke-opacity='0.5' stroke-width='1.2'/><line x1='270.2' y1='357.6' x2='273.8' y2='365.8' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='253.3' y1='364.1' x2='256.1' y2='372.6' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='235.9' y1='368.7' x2='237.7' y2='377.5' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='218.0' y1='371.6' x2='219.0' y2='380.5' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='200.0' y1='372.5' x2='200.0' y2='389.0' stroke='#9AA6D6' stroke-opacity='0.5' stroke-width='1.2'/><line x1='182.0' y1='371.6' x2='181.0' y2='380.5' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='164.1' y1='368.7' x2='162.3' y2='377.5' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='146.7' y1='364.1' x2='143.9' y2='372.6' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='129.8' y1='357.6' x2='126.2' y2='365.8' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='113.8' y1='349.4' x2='105.5' y2='363.7' stroke='#9AA6D6' stroke-opacity='0.5' stroke-width='1.2'/><line x1='98.6' y1='339.6' x2='93.3' y2='346.8' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='84.6' y1='328.2' x2='78.6' y2='334.9' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='71.8' y1='315.4' x2='65.1' y2='321.4' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='60.4' y1='301.4' x2='53.2' y2='306.7' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='50.6' y1='286.3' x2='36.3' y2='294.5' stroke='#9AA6D6' stroke-opacity='0.5' stroke-width='1.2'/><line x1='42.4' y1='270.2' x2='34.2' y2='273.8' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='35.9' y1='253.3' x2='27.4' y2='256.1' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='31.3' y1='235.9' x2='22.5' y2='237.7' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='28.4' y1='218.0' x2='19.5' y2='219.0' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='27.5' y1='200.0' x2='11.0' y2='200.0' stroke='#9AA6D6' stroke-opacity='0.5' stroke-width='1.2'/><line x1='28.4' y1='182.0' x2='19.5' y2='181.0' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='31.3' y1='164.1' x2='22.5' y2='162.3' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='35.9' y1='146.7' x2='27.4' y2='143.9' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='42.4' y1='129.8' x2='34.2' y2='126.2' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='50.6' y1='113.7' x2='36.3' y2='105.5' stroke='#9AA6D6' stroke-opacity='0.5' stroke-width='1.2'/><line x1='60.4' y1='98.6' x2='53.2' y2='93.3' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='71.8' y1='84.6' x2='65.1' y2='78.6' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='84.6' y1='71.8' x2='78.6' y2='65.1' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='98.6' y1='60.4' x2='93.3' y2='53.2' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='113.8' y1='50.6' x2='105.5' y2='36.3' stroke='#9AA6D6' stroke-opacity='0.5' stroke-width='1.2'/><line x1='129.8' y1='42.4' x2='126.2' y2='34.2' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='146.7' y1='35.9' x2='143.9' y2='27.4' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='164.1' y1='31.3' x2='162.3' y2='22.5' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/><line x1='182.0' y1='28.4' x2='181.0' y2='19.5' stroke='#9AA6D6' stroke-opacity='0.2' stroke-width='1.2'/></g><circle cx='200' cy='220' r='150' fill='none' stroke='url(#rg)' stroke-width='30' stroke-linecap='round' stroke-dasharray='942.5' stroke-dashoffset='942.5' transform='rotate(-90 200 220)' filter='url(#gl)'><animate attributeName='stroke-dashoffset' from='942.5' to='"
							& FORMAT(942.5 - _arc, "0.0", "en-US")
							& "' dur='1.6s' begin='0.2s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.2 0.8 0.2 1'/></circle><line x1='317.0' y1='258.0' x2='368.3' y2='274.7' stroke='#2DF5C4' stroke-width='4' stroke-linecap='round' filter='url(#hg)'/><text x='381.5' y='282.0' font-size='13' font-weight='700' fill='#2DF5C4' text-anchor='start'>norma 30%</text><circle cy='0' r='11' fill='#2DF5C4' filter='url(#gl)' cx='"
							& FORMAT(_mx, "0.0", "en-US")
							& "' transform='translate(0,"
							& FORMAT(_my + 20, "0.0", "en-US")
							& ")'><animate attributeName='r' values='8;14;8' dur='1.8s' repeatCount='indefinite'/></circle>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='200' y='240' font-size='88' font-weight='800' fill='#F2F5FF' text-anchor='middle' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_p * 100 * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & "%" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.1333, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.1333s'") & "/></text>", "", [Value], ASC)
							& "<text x='200' y='274' font-size='18' font-weight='500' fill='#9AA6D6' text-anchor='middle'>orta maaşın</text>"
							& "<text x='450' y='50' font-size='19' font-weight='500' fill='#9AA6D6' text-anchor='start'>2 otaqlı mənzilin median kirayəsi (Bakı şəhəri)</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='450' y='124' font-size='76' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_m2 * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & " AZN" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='450' y='166' font-size='17' font-weight='400' fill='#9AA6D6' text-anchor='start'>" & "Bakıda orta aylıq maaş " & SUBSTITUTE(FORMAT(_sal, "#,0", "en-US"), ",", " ") & " AZN · kirayədən sonra qalır " & SUBSTITUTE(FORMAT(_sal - _m2, "#,0", "en-US"), ",", " ") & " AZN" & "</text>" & "</g>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='1.0s' dur='0.4s' fill='freeze'/>" & "<text x='450' y='212' font-size='13' font-weight='700' fill='#9AA6D6' text-anchor='start' letter-spacing='1.5'>KİRAYƏ YÜKÜ (kirayə ÷ maaş)</text>" & "</g>"
							& "<text x='450' y='249' font-size='16' font-weight='600' fill='#F2F5FF' text-anchor='start'>Bakı şəhəri</text>"
							& "<rect x='620' y='236' width='300' height='16' rx='8' fill='#FFFFFF' fill-opacity='0.07'/>"
							& "<rect x='620' y='236' width='0' height='16' rx='8.0' fill='#FF3FD1' filter='url(#hg)'><animate attributeName='width' to='" & FORMAT(300 * MIN(_p, 1), "0.0", "en-US") & "' dur='1.0s' begin='1.0s' fill='freeze'/></rect>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='1.5s' dur='0.4s' fill='freeze'/>" & "<text x='970' y='250' font-size='18' font-weight='800' fill='#FF3FD1' text-anchor='end'>" & FORMAT(_p, "0%") & "</text>" & "</g>"
							& "<text x='450' y='295' font-size='16' font-weight='600' fill='#F2F5FF' text-anchor='start'>Masazır (Abşeron)</text>"
