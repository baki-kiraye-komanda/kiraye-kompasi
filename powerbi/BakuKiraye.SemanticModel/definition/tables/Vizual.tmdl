							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='1.9s' dur='0.4s' fill='freeze'/>" & "<text x='970' y='342' font-size='18' font-weight='800' fill='#8B5CFF' text-anchor='end'>" & FORMAT(_pc, "0%") & "</text>" & "</g>"
