							& "<rect x='620' y='282' width='0' height='16' rx='8.0' fill='#2DF5C4' filter='url(#hg)'><animate attributeName='width' to='" & FORMAT(300 * MIN(_pm, 1), "0.0", "en-US") & "' dur='1.0s' begin='1.2s' fill='freeze'/></rect>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='1.7s' dur='0.4s' fill='freeze'/>" & "<text x='970' y='296' font-size='18' font-weight='800' fill='#2DF5C4' text-anchor='end'>" & FORMAT(_pm, "0%") & "</text>" & "</g>"
