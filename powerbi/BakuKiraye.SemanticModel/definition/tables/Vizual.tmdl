	/// Ana səhifə KPI: unikal elan sayı + tikili növü payı
	measure 'VZ KPI Elan' =
			VAR _n = CALCULATE([Elan sayı], REMOVEFILTERS())
			VAR _new = DIVIDE(CALCULATE([Elan sayı], REMOVEFILTERS(), Elanlar[Tikili növü] = "Yeni tikili"), _n)
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='718' height='160' viewBox='0 0 718 160'><defs><filter id='kg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='3' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<rect x='24' y='0' width='120' height='3' rx='1.5' fill='#22E5FF' filter='url(#kg)'/>"
							& "<text x='24' y='36' class='l'>TƏHLİL OLUNAN UNİKAL ELAN</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='24' y='94' font-size='48' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_n * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & "" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='24' y='126' font-size='15' font-weight='600' fill='#22E5FF' text-anchor='start'>" & "bina.az · təkrarlar çıxarılıb" & "</text>" & "</g>"
							& "<rect x='390' y='62' width='300' height='12' rx='6' fill='#FFFFFF' fill-opacity='0.06'/>"
							& "<rect x='390' y='62' width='0' height='12' rx='6.0' fill='#22E5FF' ><animate attributeName='width' to='" & FORMAT(300 * _new - 3, "0.0", "en-US") & "' dur='0.8s' begin='0.3s' fill='freeze'/></rect>"
							& "<rect y='62' width='0' height='12' rx='6' fill='#FF3FD1' x='"
							& FORMAT(390 + 300 * _new, "0", "en-US")
							& "'><animate attributeName='width' to='"
							& FORMAT(300 * (1 - _new), "0", "en-US")
							& "' dur='0.8s' begin='0.6s' fill='freeze'/></rect>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='390' y='100' font-size='13' font-weight='600' fill='#22E5FF' text-anchor='start'>" & "Yeni tikili " & FORMAT(_new, "0%") & "</text>" & "</g>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='1.1s' dur='0.4s' fill='freeze'/>" & "<text x='690' y='100' font-size='13' font-weight='600' fill='#FF3FD1' text-anchor='end'>" & "Köhnə " & FORMAT(1 - _new, "0%") & "</text>" & "</g>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: 46af6fcb-668f-503d-95ae-99b249cd661d
		dataCategory: ImageUrl

	/// Ana səhifə KPI: median kirayə + qiymət paylanması (histogram)
	measure 'VZ KPI Median' =
			VAR _m = CALCULATE([Median kirayə], REMOVEFILTERS())
			VAR _p25 = CALCULATE([P25 kirayə], REMOVEFILTERS())
			VAR _p75 = CALCULATE([P75 kirayə], REMOVEFILTERS())
			VAR _b = ADDCOLUMNS(GENERATESERIES(0, 2900, 100), "@c",
			    VAR _lo = [Value] RETURN CALCULATE(COUNTROWS(Elanlar), REMOVEFILTERS(), Elanlar[Kirayə (AZN/ay)] >= _lo, Elanlar[Kirayə (AZN/ay)] < IF(_lo = 2900, 1000000, _lo + 100)))
			VAR _mx = MAXX(_b, [@c])
			VAR _bars = CONCATENATEX(_b,
			    VAR _hh = 96 * DIVIDE([@c], _mx) VAR _x = 390 + [Value] / 100 * 10.3 VAR _on = _m >= [Value] && _m < [Value] + 100
			    RETURN "<rect x='" & FORMAT(_x, "0.0", "en-US") & "' y='124' width='8.3' height='0' rx='1.5' fill='" & IF(_on, "url(#h2)", "url(#h1)") & "'>"
			        & "<animate attributeName='height' to='" & FORMAT(_hh, "0.0", "en-US") & "' dur='0.7s' begin='" & FORMAT(0.1 + [Value] / 100 * 0.025, "0.00", "en-US") & "s' fill='freeze'/>"
			        & "<animate attributeName='y' to='" & FORMAT(124 - _hh, "0.0", "en-US") & "' dur='0.7s' begin='" & FORMAT(0.1 + [Value] / 100 * 0.025, "0.00", "en-US") & "s' fill='freeze'/></rect>",
			    "", [Value], ASC)
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='718' height='160' viewBox='0 0 718 160'><defs><filter id='kg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='3' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter><linearGradient id='h1' x1='0' y1='1' x2='0' y2='0'><stop offset='0' stop-color='#8B5CFF' stop-opacity='0.15'/><stop offset='1' stop-color='#8B5CFF' stop-opacity='1'/></linearGradient><linearGradient id='h2' x1='0' y1='1' x2='0' y2='0'><stop offset='0' stop-color='#FF3FD1' stop-opacity='0.3'/><stop offset='1' stop-color='#FF3FD1' stop-opacity='1'/></linearGradient></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<rect x='24' y='0' width='120' height='3' rx='1.5' fill='#8B5CFF' filter='url(#kg)'/>"
							& "<text x='24' y='36' class='l'>MEDİAN KİRAYƏ, AZN</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='24' y='94' font-size='48' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_m * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & "" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='24' y='126' font-size='15' font-weight='600' fill='#8B5CFF' text-anchor='start'>" & "orta 50%: " & SUBSTITUTE(FORMAT(_p25, "#,0", "en-US"), ",", " ") & " – " & SUBSTITUTE(FORMAT(_p75, "#,0", "en-US"), ",", " ") & " AZN" & "</text>" & "</g>"
							& _bars
							& "<text x='390' y='146' font-size='11' font-weight='400' fill='#5B6699' text-anchor='start'>0</text>"
							& "<text x='690' y='146' font-size='11' font-weight='400' fill='#5B6699' text-anchor='end'>3 000+ AZN</text>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: 484c300d-ba42-58b3-97c3-102a0fd809df
		dataCategory: ImageUrl

	/// Ana səhifə KPI: Bakıda orta maaş vs ölkə
	measure 'VZ KPI Maaş' =
			VAR _s = [Bakı orta maaşı]
			VAR _c = [Ölkə orta maaşı]
			VAR _y = [Maaş ili]
			VAR _svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='718' height='160' viewBox='0 0 718 160'><defs><filter id='kg' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='3' result='b'/><feMerge><feMergeNode in='b'/><feMergeNode in='SourceGraphic'/></feMerge></filter></defs><style>text{font-family:Segoe UI,Inter,sans-serif}.l{font-size:13px;font-weight:700;letter-spacing:1.6px;fill:#9AA6D6}.m{fill:#9AA6D6}.d{fill:#5B6699}.t{fill:#F2F5FF}</style>"
							& "<rect x='24' y='0' width='120' height='3' rx='1.5' fill='#FFC23F' filter='url(#kg)'/>"
							& "<text x='24' y='36' class='l'>BAKIDA ORTA AYLIQ MAAŞ, AZN</text>"
							& CONCATENATEX(GENERATESERIES(1, 12, 1), "<text x='24' y='94' font-size='48' font-weight='800' fill='#F2F5FF' text-anchor='start' opacity='0'>" & "" & SUBSTITUTE(FORMAT(_s * (1 - POWER(1 - [Value] / 12, 3)), "#,0", "en-US"), ",", " ") & "" & "<set attributeName='opacity' to='1' begin='" & FORMAT(0.0 + ([Value] - 1) * 0.0750, "0.000", "en-US") & "s' " & IF([Value] = 12, "fill='freeze'", "dur='0.0750s'") & "/></text>", "", [Value], ASC)
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='24' y='126' font-size='15' font-weight='600' fill='#FFC23F' text-anchor='start'>" & "DSK, " & _y & " · nominal, vergidən əvvəl" & "</text>" & "</g>"
							& "<text x='390' y='59' font-size='14' font-weight='600' fill='#9AA6D6' text-anchor='start'>Bakı</text>"
							& "<rect x='450' y='48' width='170' height='14' rx='7' fill='#FFFFFF' fill-opacity='0.06'/>"
							& "<rect x='450' y='48' width='0' height='14' rx='7.0' fill='#FFC23F' ><animate attributeName='width' to='" & FORMAT(170 * DIVIDE(_s, _s), "0.0", "en-US") & "' dur='0.8s' begin='0.3s' fill='freeze'/></rect>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.9s' dur='0.4s' fill='freeze'/>" & "<text x='690' y='61' font-size='15' font-weight='700' fill='#F2F5FF' text-anchor='end'>" & SUBSTITUTE(FORMAT(_s, "#,0", "en-US"), ",", " ") & "</text>" & "</g>"
							& "<text x='390' y='99' font-size='14' font-weight='600' fill='#9AA6D6' text-anchor='start'>Ölkə</text>"
							& "<rect x='450' y='88' width='170' height='14' rx='7' fill='#FFFFFF' fill-opacity='0.06'/>"
							& "<rect x='450' y='88' width='0' height='14' rx='7.0' fill='#5B6699' ><animate attributeName='width' to='" & FORMAT(170 * DIVIDE(_c, _s), "0.0", "en-US") & "' dur='0.8s' begin='0.5s' fill='freeze'/></rect>"
							& "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='1.1s' dur='0.4s' fill='freeze'/>" & "<text x='690' y='101' font-size='15' font-weight='700' fill='#F2F5FF' text-anchor='end'>" & SUBSTITUTE(FORMAT(_c, "#,0", "en-US"), ",", " ") & "</text>" & "</g>"
							& "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23")
