/// CSV-lərin yeri. Standart: GitHub (hər kompüterdə Refresh işləyir, hər bazar yenilənir).
/// Lokal qovluqdan oxumaq üçün: C:\...\exports\ (sonunda \ olsun).
expression ExportFolder = "https://raw.githubusercontent.com/baki-kiraye-komanda/kiraye-kompasi/main/exports/" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: d8ef0af1-ad5a-400e-95b1-462532e61b7a

	annotation PBI_ResultType = Text

